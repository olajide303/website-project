# Environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is already in .gitignore.
# NEVER paste real keys into this file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Anthropic (AI provider) — https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model for customer-facing replies (best quality)
MODEL_REPLY=claude-sonnet-5
# Model for cheap tasks like intent classification (fast + inexpensive)
MODEL_CLASSIFY=claude-haiku-4-5-20251001
# Hard cap on tokens per reply. Lower = cheaper, may truncate long answers
MAX_REPLY_TOKENS=1024

# ---------------------------------------------------------------------------
# Meta / WhatsApp Cloud API — https://developers.facebook.com
# ---------------------------------------------------------------------------
# From your Meta Business App dashboard
META_APP_ID=
META_APP_SECRET=
# Your WhatsApp Business phone number ID (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Permanent access token, or a temp token while developing
WHATSAPP_ACCESS_TOKEN=
# Random string you choose; Meta sends it back so you can verify the webhook
WHATSAPP_VERIFY_TOKEN=
# Public URL of this server, no trailing slash
PUBLIC_URL=https://your-server.example.com

# ---------------------------------------------------------------------------
# Facebook Messenger — Phase 5
# ---------------------------------------------------------------------------
MESSENGER_PAGE_ID=
MESSENGER_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# X (Twitter) — Phase 5. Access is by approval and can take weeks.
# ---------------------------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Telegram (approval notifications) — Phase 4
# ---------------------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user or chat id. Only this id may approve orders.
TELEGRAM_ADMIN_CHAT_ID=
# Hours to wait for approval before auto-expiring an order (hours)
APPROVAL_TIMEOUT_HOURS=12
# Quiet hours for notifications (24h, WAT)
QUIET_HOURS_START=22
QUIET_HOURS_END=07

# ---------------------------------------------------------------------------
# Database — Phase 1
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/megamind.sqlite
# Toggle verbose SQL logging
DATABASE_LOGGING=false

# ---------------------------------------------------------------------------
# Website / chat widget — Phase 3
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://megamind.com.ng
NEXT_PUBLIC_WIDGET_ENABLED=true

# ---------------------------------------------------------------------------
# Operations — Phase 2 and 7
# ---------------------------------------------------------------------------
# Where to send outage alerts
ALERT_WEBHOOK_URL=
# Minutes of downtime before alerting you
DEADMAN_MINUTES=5
# Backups
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
# Nightly cost threshold that triggers a warning (USD)
COST_ALERT_THRESHOLD_USD=5
